# Secrets only. Non-secret communication config belongs in services.yaml.
# SERVICE_REGISTRY_PATH may be set by systemd or shell when needed.
SERVICE_NAME=api_report_agent
SERVICE_REGISTRY_PATH=/opt/personal-infra/services.yaml

# Caller-side token for invoking private_info_db when registry token_env points here.
PRIVATE_INFO_DB_TOKEN=replace-me

# Server-side token for services that use setup_message_pipeline(auth_mode="bearer").
API_TOKEN=replace-me
