[Unit]
Description=Example business service using personal-infra-tools
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=app
WorkingDirectory=/opt/example-fastapi-service
Environment=SERVICE_NAME=api_report_agent
Environment=SERVICE_REGISTRY_PATH=/opt/personal-infra/services.yaml
EnvironmentFile=-/opt/example-fastapi-service/.env
ExecStart=/opt/example-fastapi-service/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8020
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
